---
import SiteLayout from "../../layouts/SiteLayout.astro";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://buburtech.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Projects",
        item: "https://buburtech.com/projects/",
      },
    ],
  },
];
---

<SiteLayout
  title="Cybersecurity Projects | Rifqi Rofian Tanamas"
  description="Three cybersecurity case studies by Rifqi Rofian Tanamas covering Splunk detection engineering, Bitdefender rollout, and multi-client SOC operations."
  canonical="https://buburtech.com/projects/"
  schema={schema}
>
  <header class="case-intro">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol>
          <li>
            <a href="/">Home</a>
          </li>
          <li aria-current="page">Projects</li>
        </ol>
      </nav>
      <h1>Cybersecurity projects</h1>
      <p class="case-lead">
        Three projects from my work in security operations, detection
        engineering, and endpoint security.
      </p>
    </div>
  </header>
  <ul class="case-list wrap">
    <li>
      <h2>
        <a href="/projects/bitdefender-endpoint-deployment/">
          Bitdefender endpoint deployment
        </a>
      </h2>
      <p>
        I led a four-person team that deployed Bitdefender to 2,850 endpoints at
        Statistics Indonesia and trained the client team before handover.
      </p>
    </li>
    <li>
      <h2>
        <a href="/projects/splunk-detection-engineering/">
          Splunk detection engineering
        </a>
      </h2>
      <p>
        I advised Indonesia’s customs agency on Splunk dashboards, use cases,
        and Python automation. The detection tuning cut false positives by 90%.
      </p>
    </li>
    <li>
      <h2>
        <a href="/projects/multi-client-siem-operations/">
          Multi-client SIEM operations
        </a>
      </h2>
      <p>
        I triaged about 20 incidents per week across three managed clients and
        documented how analysts classified alerts across shifts.
      </p>
    </li>
  </ul>
</SiteLayout>
