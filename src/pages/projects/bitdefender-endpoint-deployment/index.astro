---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://buburtech.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Projects",
        item: "https://buburtech.com/projects/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Bitdefender endpoint deployment",
        item: "https://buburtech.com/projects/bitdefender-endpoint-deployment/",
      },
    ],
  },
];
---

<SiteLayout
  title="Bitdefender Rollout to 2,850 Endpoints | Rifqi Rofian Tanamas"
  description="How Rifqi Rofian Tanamas led a four-person Bitdefender rollout across 2,850 endpoints at Statistics Indonesia and trained the client team at handover."
  canonical="https://buburtech.com/projects/bitdefender-endpoint-deployment/"
  schema={schema}
>
  <header class="case-intro">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol>
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/projects/">Projects</a>
          </li>
          <li aria-current="page">Bitdefender endpoint deployment</li>
        </ol>
      </nav>
      <h1>Bitdefender endpoint deployment</h1>
      <p class="case-lead">
        I led a four-person implementation team through a Bitdefender antivirus
        rollout to 2,850 endpoints at Statistics Indonesia.
      </p>
    </div>
  </header>
  <div class="case-detail wrap">
    <dl class="case-facts">
      <div>
        <dt>Client</dt>
        <dd>Badan Pusat Statistik (Statistics Indonesia)</dd>
      </div>
      <div>
        <dt>Role</dt>
        <dd>Project Lead</dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd>
          <time datetime="2024">2024</time>
        </dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd>2,850 endpoints</dd>
      </div>
    </dl>
    <div class="case-copy">
      <section aria-labelledby="rollout">
        <h2 id="rollout">Rollout and coordination</h2>
        <p>
          At Focus Solusi Infotama, I managed the Bitdefender implementation at
          the national statistics agency and kept delivery within the agreed
          service level.
        </p>
      </section>
      <section aria-labelledby="handover">
        <h2 id="handover">Training and handover</h2>
        <p>
          The handover included hands-on training in the Bitdefender console so
          the client team could operate the platform after the implementation
          team left.
        </p>
      </section>
      <section aria-labelledby="related">
        <h2 id="related">Related project</h2>
        <p>
          I also advised on SIEM dashboards and alert tuning in the{" "}
          <a href="/projects/splunk-detection-engineering/">
            Splunk detection engineering case study
          </a>{" "}
          for Indonesia’s customs agency.
        </p>
      </section>
    </div>
  </div>
</SiteLayout>
