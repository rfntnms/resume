---
import SiteLayout from "../../../layouts/SiteLayout.astro";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://buburtech.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Projects",
        item: "https://buburtech.com/projects/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Multi-client SIEM operations",
        item: "https://buburtech.com/projects/multi-client-siem-operations/",
      },
    ],
  },
];
---

<SiteLayout
  title="Multi-Client SIEM and SOC Operations | Rifqi Rofian Tanamas"
  description="SOC case study by Rifqi Rofian Tanamas covering incident triage across three managed clients using Splunk, IBM QRadar, and Wazuh."
  canonical="https://buburtech.com/projects/multi-client-siem-operations/"
  schema={schema}
>
  <header class="case-intro">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol>
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/projects/">Projects</a>
          </li>
          <li aria-current="page">Multi-client SIEM operations</li>
        </ol>
      </nav>
      <h1>Multi-client SIEM operations</h1>
      <p class="case-lead">
        At Alpha Citra Siber Indonesia, I triaged about 20 security incidents
        per week across three managed clients on a rotating 24/7 SOC shift.
      </p>
    </div>
  </header>
  <div class="case-detail wrap">
    <dl class="case-facts">
      <div>
        <dt>Employer</dt>
        <dd>Alpha Citra Siber Indonesia</dd>
      </div>
      <div>
        <dt>Role on the project</dt>
        <dd>L1 SOC Analyst</dd>
      </div>
      <div>
        <dt>Period</dt>
        <dd>
          <time datetime="2023">2023</time>–<time datetime="2024">2024</time>
        </dd>
      </div>
      <div>
        <dt>SIEM tools</dt>
        <dd>Splunk, IBM QRadar, Wazuh</dd>
      </div>
    </dl>
    <div class="case-copy">
      <section aria-labelledby="triage">
        <h2 id="triage">Incident triage</h2>
        <p>
          I used Splunk, IBM QRadar, and Wazuh to monitor and triage security
          incidents across separate client environments. I helped tune detection
          logic and SIEM settings to improve alert accuracy and reduce
          unnecessary escalations.
        </p>
      </section>
      <section aria-labelledby="documentation">
        <h2 id="documentation">Alert classification and documentation</h2>
        <p>
          I documented the team’s alert classification standards so analysts
          could apply them consistently across shifts. I also contributed
          technical documentation for Splunk implementation.
        </p>
      </section>
      <section aria-labelledby="related">
        <h2 id="related">Related project</h2>
        <p>
          See the{" "}
          <a href="/projects/splunk-detection-engineering/">
            Splunk detection engineering case study
          </a>{" "}
          for my later work on dashboard and detection tuning for a government
          SOC.
        </p>
      </section>
    </div>
  </div>
</SiteLayout>
