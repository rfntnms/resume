---
import "../styles/portfolio.css";
interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: unknown;
  resume?: boolean;
}
const { title, description, canonical, schema, resume = false } = Astro.props;
const navigation = [
  ["Experience", "/#experience"],
  ["Projects", "/#projects"],
  ["Credentials", "/#certifications"],
  ["Contact", "/#contact"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rifqi Rofian Tanamas" />
    <meta name="robots" content="max-image-preview:large" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="/assets/favicon.png"
      type="image/png"
      sizes="96x96"
    />
    <meta
      property="og:type"
      content={canonical === "https://buburtech.com/" ? "profile" : "article"}
    />
    <meta property="og:site_name" content="Buburtech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://buburtech.com/assets/og-image.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Rifqi Rofian Tanamas — L2 Security Analyst"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://buburtech.com/assets/og-image.jpg"
    />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark")
          document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link
      rel="preload"
      href="/assets/fonts/barlow-condensed-extrabold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
      />
    )}
  </head>
  <body id="top" class:list={[resume && "resume-page"]}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header-shell">
      <div class="site-header wrap">
        <a class="wordmark" href="/" aria-label="buburtech home">
          buburtech<span>.</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          {navigation.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="resume-link" href="/resume/">
            Resume{" "}
            <img
              src="/assets/icons/arrow-up-right.svg"
              width="20"
              height="20"
              alt=""
            />
          </a>
          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch color theme"
            hidden
          >
            <img src="/assets/icons/sun.svg" width="19" height="19" alt="" />
          </button>
          <button
            class="menu-toggle"
            type="button"
            aria-haspopup="dialog"
            aria-controls="chapter-menu"
            hidden
          >
            Menu
          </button>
        </div>
      </div>
    </header>
    <dialog
      class="chapter-menu"
      id="chapter-menu"
      aria-labelledby="chapter-menu-title"
    >
      <div class="menu-inner wrap">
        <div class="menu-header">
          <p id="chapter-menu-title">Browse portfolio</p>
          <button class="menu-close" type="button" autofocus>
            Close
          </button>
        </div>
        <nav aria-label="Mobile navigation">
          <a href="/#top">Home</a>
          {navigation.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
          <a href="/resume/">Resume</a>
        </nav>
      </div>
    </dialog>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>© 2026 Rifqi Rofian Tanamas</p>
      <a href="#top">Back to top</a>
    </footer>
    <script is:inline type="module" src="/assets/site.js?v=portrait-1"></script>
  </body>
</html>
